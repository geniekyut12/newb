<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@drawable/welcomebg"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/desgin2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10sp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Image view for character -->
        <ImageView
            android:id="@+id/popUpImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/welcome4" />

        <!-- Text bubble -->
        <TextView
            android:id="@+id/popUpText"
            android:layout_width="150sp"
            android:layout_height="80sp"
            android:layout_marginTop="-262dp"
            android:layout_marginEnd="50sp"
            android:text="@string/foood"
            android:textSize="16sp"
            android:fontFamily="@font/poppinsmedium"
            android:textAlignment="center"
            android:background="@drawable/bubble"
            android:padding="8dp"
            android:textColor="@color/BlckYellow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/text32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-135sp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/popUpText133"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/food"
            android:textSize="24sp"
            android:layout_gravity="left"
            android:fontFamily="@font/poppinsmedium"
            android:textColor="@color/YGreen"
            android:gravity="center"/>

        <!-- TextView popUpText13 at the bottom center -->
        <TextView
            android:id="@+id/popUpText13"
            android:layout_width="340sp"
            android:layout_height="85sp"
            android:layout_marginTop="-5sp"
            android:text="@string/welcome4"
            android:textSize="14sp"
            android:textAlignment="textStart"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/YGreen" />
    </LinearLayout>

    <!-- Button for next, placed below popUpText13 -->
    <LinearLayout
        android:id="@+id/btnnxt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28sp"
        android:layout_marginBottom="28sp"
        android:gravity="center">

        <Button
            android:id="@+id/btnWBack4"
            android:layout_width="120sp"
            android:layout_height="50sp"
            android:layout_marginTop="-1sp"
            android:layout_marginEnd="90sp"
            style="@style/popupbtn"
            android:fontFamily="@font/poppinsmedium"
            android:text="@string/back" />

        <Button
            android:id="@+id/btnWNext4"
            android:layout_width="120sp"
            android:layout_height="50sp"
            android:layout_marginTop="-1sp"
            style="@style/popupbtn"
            android:fontFamily="@font/poppinsmedium"
            android:text="@string/next" />
    </LinearLayout>

</LinearLayout>
