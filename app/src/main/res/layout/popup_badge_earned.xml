<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@android:color/transparent">

    <!-- 1) A vertical layout for the background bubble (rectangle + tail) -->
    <LinearLayout
        android:id="@+id/layoutBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- FrameLayout so we can overlay banner and banner2 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- The first banner image -->

            <!-- The second image overlay (banner2) -->
            <ImageView
                android:id="@+id/imageBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:src="@drawable/banner" />


        </FrameLayout>

        <!-- The triangle tail at the bottom center -->
        <ImageView
            android:id="@+id/imageTail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/tail_banner" />
    </LinearLayout>

    <!-- 2) Overlay content on top of the combined banner area -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="382dp"
        android:layout_height="425dp"
        android:layout_marginTop="150dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">


        <TextView
            android:id="@+id/textBadgeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <!-- "Well done!" text -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Well done!"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Sub-message -->
        <TextView
            android:id="@+id/textSubMessage"
            android:layout_width="341dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="start"
            android:text="\u2022 You’ve completed 1500 steps.\n\u2022 You’ve reduced your carbon footprint with that walk.\n\u2022 You’ve earned 100 points and 100 coins!\n\nKeep making sustainable choices!"
            android:textAlignment="viewStart"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
        <!-- Continue button -->
        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="CONTINUE"
            android:textColor="@android:color/black" />

    </LinearLayout>

</FrameLayout>