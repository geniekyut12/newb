<android.widget.ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/welcomebg"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/desgin2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8sp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Image view for character -->
            <ImageView
                android:id="@+id/popUpImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/welcome1" />

            <!-- Text bubble -->
            <TextView
                android:id="@+id/popUpText1"
                android:layout_width="150sp"
                android:layout_height="85sp"
                android:layout_marginTop="-765dp"
                android:layout_marginStart="-30sp"
            android:text="@string/diduknow"
            android:textSize="16sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_bold"
            android:background="@drawable/bubble"
            android:textColor="@color/BlckYellow" />
        </LinearLayout>

        <!-- TextView popUpText13 at the bottom center -->
        <TextView
            android:id="@+id/popUpText13"
            android:layout_width="340sp"
            android:layout_height="85sp"
            android:text="@string/welcome2"
            android:textSize="14sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppinsregular"
            android:textColor="@color/YGreen"
            android:layout_marginTop="-112dp"
            android:gravity="center"/>

        <!-- Button for next, placed below popUpText13 -->
        <LinearLayout
            android:id="@+id/btnnxt1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48sp"
            android:gravity="center">

            <Button
                android:id="@+id/btnWBack2"
                android:layout_width="120sp"
                android:layout_height="50sp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="50sp"
                style="@style/popupbtn"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnWNext2"
                android:layout_width="120sp"
                android:layout_height="50sp"
                android:layout_marginTop="0dp"
                style="@style/popupbtn"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/next" />
        </LinearLayout>

    </LinearLayout>

</android.widget.ScrollView>
