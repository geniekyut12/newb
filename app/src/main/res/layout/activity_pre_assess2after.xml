<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/vid2bg" />

    <!-- Scrollable Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="100dp"
            android:paddingBottom="126dp"
            android:gravity="center_horizontal">

            <!-- After Pre1 Section -->
            <LinearLayout
                android:id="@+id/afterpre1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="51dp"
                android:background="@drawable/textbgwhite"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Logo -->
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="152dp"
                    android:layout_height="152dp"
                    android:layout_marginTop="25dp"
                    app:srcCompat="@drawable/cverdee" />

                <!-- Well Done -->
                <TextView
                    android:id="@+id/wtg"
                    android:layout_width="wrap_content"
                    android:layout_height="68dp"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/poppinsregular"
                    android:gravity="center"
                    android:text="@string/WD"
                    android:textColor="#000000"
                    android:textSize="50sp"
                    android:textStyle="bold" />

                <!-- Total Carbon Text -->
                <TextView
                    android:id="@+id/totalcarb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="@string/pre1scoress"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Total Carbon Value -->
                <TextView
                    android:id="@+id/pre2score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/pre1score"
                    android:textColor="@color/darkG"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Additional Note -->
                <TextView
                    android:id="@+id/wtgm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="51dp"
                    android:fontFamily="@font/afacad"
                    android:gravity="center"
                    android:text="@string/prenote"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Next Button -->
            <Button
                android:id="@+id/pre2done"
                android:layout_width="231dp"
                android:layout_height="59dp"
                android:layout_marginTop="20dp"
                style="@style/assessbtn"
                android:background="@drawable/preassesbtn"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/next"
                android:textColor="@color/Green"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
