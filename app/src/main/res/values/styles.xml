<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TermsCond" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/YGreen</item>
        <item name="colorPrimaryDark">@color/LGreen</item>
        <item name="colorAccent">@color/LGreen</item>
    </style>

    <!-- Style for background image -->
    <style name="AppTheme.BackgroundImageStyle" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/homeblue</item>
    </style>

    <style name="TransparentFullScreenDialog" parent="@style/Theme.AppCompat.Dialog.Alert">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- This line must be true if you want the default dim behind the dialog -->
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Custom RadioButton -->
    <style name="CustomRadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/Green</item> <!-- Green circle color -->
        <item name="android:textColor">@color/LBrown</item> <!-- Text color -->
    </style>

    <!-- Full-screen theme for VehicleStatusActivity -->
    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- BUTTON SA POP-UP NG WELCOME -->
    <style name="popupbtn" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/redbtn</item>
        <item name="backgroundTint">@null</item> <!-- Removes Material default tint -->
    </style>

    <!-- Register Style -->
    <style name="popupbtn1" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/redbtn1</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Custom Button Style -->
    <style name="gradientt" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btnbg23</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/btnbg23</item>
        <item name="android:textColor">@color/LBrown</item>
    </style>

    <style name="walangdes" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btngetstart</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Actlog Button -->
    <style name="actlogg" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/actlogbgg</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- PreAsses Button -->
    <style name="assessbtn" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/preassesbtn</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- PreAsses Button -->
    <style name="assessbtn1" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/preassesbtn2</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- PostAsses Button -->
    <style name="assessbtn3" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btnblue</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- Badge Claim Button -->
    <style name="badgebtn1" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/badgeclaim</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="blurr" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/blurrbg1</item>
        <item name="backgroundTint">@null</item>
    </style>



</resources>
